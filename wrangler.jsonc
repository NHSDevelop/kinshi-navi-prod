{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kinshi-navi",
  "account_id": "ed8cb8c6686433c7b0ad9c1febb6d856",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kinshi-navi",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "kinshi-navi-prod",
    },
    {
      "binding": "NEXT_CACHE_R2_BUCKET",
      "bucket_name": "kinshi-navi-cache",
    },
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinshi-navi-prod",
      "database_id": "1fd0c0bd-ccbc-42a2-aab3-fb222c8abb14",
      "migrations_dir": "drizzle/migrations",
      "remote": false,
    },
  ],
}
